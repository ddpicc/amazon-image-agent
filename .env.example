# PageMint Environment Variables

# Database
DATABASE_URL=postgresql://user:password@host:5432/page_mint

# App secrets
APP_SECRET=replace_with_a_long_random_secret
PROVIDER_KEY_ENCRYPTION_KEY=replace_with_a_second_long_random_secret
APP_BASE_URL=https://your-agent.example.com

# Remote image worker bridge
IMAGE_WORKER_BASE_URL=https://your-image-worker.example.com
IMAGE_WORKER_API_KEY=worker_api_key_for_agent
IMAGE_WORKER_TIMEOUT_MS=15000

# JustOneAPI 1688 product details
JUSTONE_API_BASE_URL=https://api.justoneapi.com
JUSTONE_API_TOKEN=your_justoneapi_token

# Resend email
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=noreply@example.com

# Tencent COS（agent 与 worker 共用新加坡桶：agent 放参考图，worker 放成品图）
COS_SECRET_ID=replace_with_your_tencent_cos_secret_id
COS_SECRET_KEY=replace_with_your_tencent_cos_secret_key
COS_REGION=
COS_BUCKET=
COS_PUBLIC_BASE_URL=

# Bootstrap admin account for db:seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please

# Canopy API：ASIN 商品标题和图片读取（首选）
CANOPY_API_KEY=your_canopy_api_key

# Pangol ScrapeAPI：ASIN 商品读取备用，以及合规体检的全球外观专利（WIPO）自动检索
PANGOL_SCRAPEAPI_API_KEY=your_pangol_scrapeapi_key
