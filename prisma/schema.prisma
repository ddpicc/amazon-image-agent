generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum AnalysisStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum GenerationStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum SourcePage {
  AMAZON
  PLAYGROUND
}

enum UpstreamApiKind {
  UNKNOWN
  IMAGES_EDIT
  IMAGES_GENERATE
}

enum PointsPackageStatus {
  ACTIVE
  INACTIVE
}

enum PointsLedgerType {
  REDEEM_CODE
  PAYMENT_RECHARGE
  GENERATION_DEBIT
  GENERATION_REFUND
  SIGNUP_BONUS
  REFERRAL_INVITEE_BONUS
  REFERRAL_INVITER_REWARD
  ADMIN_ADJUSTMENT
}

enum RedemptionCodeStatus {
  ACTIVE
  REDEEMED
  DISABLED
  EXPIRED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  role                    UserRole                 @default(USER)
  referralCode            String                   @unique
  invitedByUserId         String?
  pointsBalance           Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  analysisRecords         AnalysisRecord[]
  imageGenerationRequests ImageGenerationRequest[]
  pointsLedgerEntries     PointsLedgerEntry[]      @relation("PointsLedgerUser")
  createdRedemptionCodes  RedemptionCode[]         @relation("RedemptionCodeCreator")
  redeemedCodes           RedemptionCode[]         @relation("RedemptionCodeRedeemer")
  paymentOrders           PaymentOrder[]
  invitedBy               User?                    @relation("UserReferrals", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedUsers            User[]                   @relation("UserReferrals")

  @@index([invitedByUserId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email, createdAt(sort: Desc)])
  @@index([email, expiresAt])
  @@index([email, consumedAt])
}

model AnalysisRecord {
  id                  String         @id @default(cuid())
  userId              String
  productName         String
  description         String
  category            String
  targetAudience      String
  referenceImageCount Int            @default(0)
  referenceImagesJson Json?
  status              AnalysisStatus @default(STARTED)
  productSummary      String?
  analysisJson        Json?
  promptPlanJson      Json?
  errorMessage        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model ImageProvider {
  id               String                   @id @default(cuid())
  name             String                   @unique
  vendor           String
  baseUrl          String
  model            String
  priority         Int                      @default(100)
  enabled          Boolean                  @default(true)
  apiKeyCiphertext String
  failureCount     Int                      @default(0)
  lastFailureAt    DateTime?
  lastSuccessAt    DateTime?
  cooldownUntil    DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  attempts         ImageGenerationAttempt[]
  requests         ImageGenerationRequest[]

  @@index([enabled, priority])
}

model TextProvider {
  id               String   @id @default(cuid())
  name             String   @unique
  vendor           String
  baseUrl          String
  model            String
  priority         Int      @default(100)
  enabled          Boolean  @default(true)
  apiKeyCiphertext String
  failureCount     Int      @default(0)
  lastFailureAt    DateTime?
  lastSuccessAt    DateTime?
  cooldownUntil    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled, priority])
}

model ImageGenerationRequest {
  id                      String                   @id @default(cuid())
  userId                  String
  sourcePage              SourcePage
  entryApi                String
  selectedProviderId      String?
  selectedProviderName    String?
  selectedProviderBaseUrl String?
  selectedProviderModel   String?
  attemptCount            Int                      @default(0)
  finalUpstreamApiKind    UpstreamApiKind          @default(UNKNOWN)
  status                  GenerationStatus         @default(STARTED)
  durationMs              Int?
  prompt                  String
  revisedPrompt           String?
  imageType               String?
  aspectRatio             String?
  size                    String?
  referenceImageCount     Int                      @default(0)
  errorMessage            String?
  pointsLedgerEntryId     String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedProvider        ImageProvider?           @relation(fields: [selectedProviderId], references: [id], onDelete: SetNull)
  attempts                ImageGenerationAttempt[]
  assets                  GeneratedImageAsset[]
  pointsLedgerEntry       PointsLedgerEntry?       @relation(fields: [pointsLedgerEntryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([selectedProviderId])
}

model ImageGenerationAttempt {
  id              String          @id @default(cuid())
  requestId       String
  providerId      String?
  baseUrl         String
  model           String
  attemptIndex    Int
  status          AttemptStatus   @default(STARTED)
  durationMs      Int?
  errorMessage    String?
  upstreamApiKind UpstreamApiKind @default(UNKNOWN)
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  request         ImageGenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider        ImageProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([requestId, attemptIndex])
  @@index([providerId])
}

model GeneratedImageAsset {
  id        String   @id @default(cuid())
  requestId String
  cosUrl    String
  cosKey    String
  mimeType  String
  bytes     Int
  createdAt DateTime @default(now())
  request   ImageGenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model PointsPackage {
  id              String              @id @default(cuid())
  name            String              @unique
  points          Int
  priceCents      Int
  currency        String              @default("CNY")
  displayOrder    Int                 @default(0)
  status          PointsPackageStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  redemptionCodes RedemptionCode[]
  paymentOrders   PaymentOrder[]

  @@index([status, displayOrder])
}

model PointsLedgerEntry {
  id                      String                @id @default(cuid())
  userId                  String
  type                    PointsLedgerType
  pointsDelta             Int
  balanceAfter            Int
  idempotencyKey          String                @unique
  referenceType           String?
  referenceId             String?
  metadata                Json?
  createdAt               DateTime              @default(now())
  user                    User                  @relation("PointsLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  imageGenerationRequest  ImageGenerationRequest?

  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
}

model RedemptionCode {
  id               String               @id @default(cuid())
  plainCode        String?              @unique
  codeHash         String               @unique
  packageId        String?
  points           Int
  status           RedemptionCodeStatus @default(ACTIVE)
  batchId          String?
  expiresAt        DateTime?
  redeemedAt       DateTime?
  redeemedByUserId String?
  createdByUserId  String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  redemptionPackage PointsPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  redeemedBy       User?                @relation("RedemptionCodeRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  createdBy        User                 @relation("RedemptionCodeCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([batchId])
}

model PaymentOrder {
  id              String             @id @default(cuid())
  userId          String
  packageId       String
  outTradeNo      String?            @unique
  status          PaymentOrderStatus @default(PENDING)
  amountCents     Int
  currency        String             @default("CNY")
  payType         String?
  provider        String?
  providerOrderId String?            @unique
  payUrl          String             @default("")
  payUrl2         String             @default("")
  qrcodeUrl       String             @default("")
  qrcodeImg       String             @default("")
  metadata        Json?
  notifyPayload   Json?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentPackage  PointsPackage      @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}
